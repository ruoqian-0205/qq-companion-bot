{
  "bot": {
    "qq": 1234567890,
    "name": "小深",
    "reply_probability": 0.7,
    "fallback_reply": "喵……刚才网络开小差了，再说一次好不好？",
    "clear_memory_reply": "喵~ 记忆已经清空啦，我们重新开始吧！"
  },

  "model": {
    "text_base_url": "https://api.deepseek.com",
    "text_model": "deepseek-flash",
    "vision_base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "vision_model": "qwen3.7-flash",
    "max_images_per_message": 3,
    "thinking": true
  },

  "persona": {
    "outer_file": "persona.txt",
    "inner_file": "",
    "inner_accounts": [],
    "inner_fallback_reply": "",
    "inner_clear_memory_reply": ""
  },

  "whitelist": {
    "private": [],
    "group": []
  },

  "group_chat": {
    "at_only": true,
    "keywords": ["小深", "猫娘"],

    "p_max": 0.7,
    "p_min": 0.05,
    "heat_per_message": 0.15,
    "heat_fast_half_life_seconds": 120,
    "heat_slow_half_life_seconds": 1800,
    "self_bump": 0.5,
    "engage_peak": 0.95,
    "engage_up": 0.75,
    "engage_keyword": 0.45,
    "engage_self_damp": 0.45,
    "engage_followup_seconds": 30,
    "engage_half_life_seconds": 90
  },

  "proactive": {
    "interval_private": [1800, 7200],
    "interval_group": [10800, 21600],
    "to_each": 0.5,
    "quiet_private": 60,
    "quiet_group": 300
  },

  "memory": {
    "file": "memory.json",
    "split_reply": {
      "enabled": true,
      "max": 10,
      "interval": [0.5, 1.5]
    }
  },

  "long_memory": {
    "enabled": true,
    "file": "memory_long.json",
    "l0_max": 260,
    "compress_count": 120,
    "compress_delay": 3,
    "l0_hard_limit": 780,
    "l1_max_facts": 60,
    "l1_type_quota": { "who": 20, "us": 24, "event": 16 },
    "l1_inject_hard_limit": 200,
    "recent_days": 3,
    "recent_max_items": 200,
    "persona_max_chars": 400,
    "thinking": true,
    "max_tokens": 16000
  },

  "runtime": {
    "ws_url": "ws://127.0.0.1:3001",
    "silent_hours": { "enabled": true, "start": 0, "end": 10 },
    "log_file_enabled": true,
    "log_file": "bot_error.log"
  },

  "backend": {
    "auto_relogin": true,
    "qq_client_path": "D:\\Tencent\\QQNT\\QQ.exe",
    "autologin_script": "napcat-autologin.bat",
    "health_check_interval": 30,
    "relogin_wait_seconds": 180,
    "relogin_max_per_hour": 2,
    "qrcode_image": "D:\\tools\\NapCat\\cache\\qrcode.png",
    "qrconsole_log": "",
    "qr_detect_timeout": 20,
    "scan_prompt_timeout": 300,
    "kill_qq_on_exit": true
  }
}
