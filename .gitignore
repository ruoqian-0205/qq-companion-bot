# 环境变量（含密钥）
.env
.env.local

# 实际配置文件（包含个人信息）
config.json
persona.txt
persona.local.txt
me.txt
me.*.txt

# 记忆文件（自动生成，含聊天隐私，务必不要提交）
memory.json
memory_long.json
# 记忆文件的派生产物：原子写的临时文件、写盘前的轮转备份(.bak1~3)、一次性恢复产物。
# 不加这两条通配的话，它们会一直以未跟踪状态出现在 git status 里，
# 哪天顺手 git add -A 就会把聊天隐私提交上去。
memory.json.*
memory_long.json.*
*.tmp

# 快速登录脚本及其运行日志（含本机路径、机器人 QQ 号，属于本机专属配置）
napcat-autologin.bat
napcat-autologin.log

# bot 的错误日志（含 QQ 号与聊天内容片段，务必不要提交）
bot_error.log
bot_error.log.*

# 扫码登录时生成的二维码临时页面
napcat-qrcode.html

# Python
__pycache__/
*.pyc
.venv/
venv/

# 编辑器
.idea/
.vscode/